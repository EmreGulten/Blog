            <li><img src="https://via.placeholder.com/108x100" alt=""></li>
            <li><img src="https://via.placeholder.com/108x100" alt=""></li>
            <li><img src="https://via.placeholder.com/108x100" alt=""></li>
        </ul><!--pt-carousel end-->
    </div>
</section><!--partner-section end-->