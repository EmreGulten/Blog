@model ArticleListDto

<style>
    .truncated-content {
        word-wrap: break-word;
    }
</style>

<section class="pager-sec-blog overlay-dark">
    <div class="container">
        <div class="pager-sec-details">
            <ul class="breadcrumb">
                
            </ul>
        </div><!--pager-sec-details end-->
    </div>
</section><!--pager-sec end-->

<section class="page-content">
    <div class="container">
        <div class="blog-style2">
            <div class="row">
                <div class="col-lg-8">
                    <div class="blog-items-sec">

                        @{
                            foreach (var item in Model.Articles)
                            {
                                
                                
                                <div class="blog-post">
                                    <div class="blog-thumbnail">
                                        <img src="~/images/@item.Image.FileName" alt="">
                                        <span class="category-name">@item.Category.Name</span>
                                        <a asp-controller="Home" asp-action="BlogSingle" asp-route-articleId="@item.Id"></a>
                                    </div>
                                    <div class="blog-info">
                                        <h2><a asp-controller="Home" asp-action="BlogSingle" asp-route-articleId="@item.Id">@item.Title</a></h2>
                                        <p class="truncated-content">@item.Content</p>
                                        <div class="posted-by-row">
                                            <img src="@item.Image.Users" alt="">
                                            <h4><a href="#" title="">@item.User.FirstName @item.User.LastName</a>     <span>@item.CreatedDate.ToString("dd/MM/yyyy")</span> <span>@item.Comments.Count</span></h4>
                                            <a href="#" title=""><i class="fa fa-share-alt"></i></a>
                                        </div><!--posted-by-row end-->
                                    </div>
                                </div>

                                <!--blog-post end-->
                            }
                        }



                    </div><!--blog-items-sec end-->
                    <div class="serity-pagination">
                        <nav aria-label="Page navigation example">
                            <ul class="pagination">
                                @if (Model.ShowPrevious)
                                {
                                    <li class="page-item">
                                        <a class="page-link" asp-route-currentPage="@(Model.CurrentPage - 1)" asp-route-pageSize="@Model.PageSize"> Önceki </a>
                                    </li>
                                }
                                @for (int i = 1; i < Model.TotalPages; i++)
                                {
                                    <li class="page-item">
                                        <a class="page-link" asp-route-currentPage="@i" asp-route-pageSize="@Model.PageSize"> @i </a>
                                    </li>
                                }
                                @if (Model.ShowNext)
                                {
                                    <li class="page-item">
                                        <a class="page-link" asp-route-currentPage="@(Model.CurrentPage + 1)" asp-route-pageSize="@Model.PageSize"> Sonraki </a>
                                    </li>
                                }
                            </ul>
                        </nav>
                    </div>
                </div>
                <div class="col-lg-4">
                    <div class="sidebar blog-sidebar">
                        <div class="widget widget-search">
                            <form id="search_form" asp-controller="Home" asp-action="Search" method="GET">
                                <input type="text" name="keyword" class="searchText" placeholder="Arama yapınız..." autocomplete="on">
                                <button type="submit"><i class="fa fa-search"></i></button>
                            </form>
                        </div><!--widget-search end-->
                        <div class="widget widget-categories">
                            <h3 class="widget-title">Kategoriler</h3>
                            <ul>
                                @{
                                    if (Model.Categories != null)
                                    {
                                        foreach (var item in Model.Categories)
                                        {
                                            <li>
                                                <a asp-controller="Home" asp-action="BlogTwo" asp-route-categoryId="@item.Id"><i class="fa fa-video"></i>@item.Name</a>
                                            </li>
                                        }
                                    }
                                    else
                                    {
                                        foreach (var item in Model.Articles)
                                        {
                                            <li>
                                                <a asp-controller="Home" asp-action="BlogTwo" asp-route-categoryId="@item.CategoryId"><i class="fa fa-video"></i>@item.Category.Name</a>
                                            </li>
                                        }
                                    }

                                }


                            </ul>
                            <div class="clearfix"></div>
                        </div><!--widget-categories end-->
                        <div class="widget widget-tags">
                            <h3 class="widget-title">Popüler Taglar</h3>
                            <ul>

                                @foreach (var item in Model.Articles)
                                {
                                    foreach (var t in item.Tags)
                                    {
                                        <li><a href="#" title="">@t.Tags</a></li>
                                    }
                                }
                            </ul>
                        </div><!--widget-tags end-->
                        <!--<div class="widget widget-meta"> // ismail bakarsın
                            <h3 class="widget-title">Meta</h3>
                            <ul>
                                <li>
                                    <a href="#" title="">Login</a>
                                </li>
                                <li>
                                    <a href="#" title="">Registration</a>
                                </li>
                                <li>
                                    <a href="#" title="">Entries</a>
                                </li>
                                <li>
                                    <a href="#" title="">Comments</a>
                                </li>
                                <li>
                                    <a href="#" title="">WordPress.org</a>
                                </li>
                            </ul>
                            <div class="clearfix"></div>
                        </div>-->
                        <!--widget-categories end-->


                    </div><!--sidebar end-->
                </div>
            </div>
        </div><!--blog-style2 end-->

    </div>
</section><!--page-content end-->

