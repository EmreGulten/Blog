</style>

<div class="search-popup">
    <form id="search_form" asp-controller="Home" asp-action="Search" method="GET">
        <input type="text" name="keyword" class="searchText" placeholder="Arama yapınız..." autocomplete="on">
        <button type="submit"><i class="fa fa-search"></i></button>
    </form>
    <a href="#" title="" class="close-search"><i class="fa fa-window-close"></i></a>
</div><!--search-popup end-->

<section class="banner-section white-box style2">
    <div class="banner-slider">
        <div class="banner-slide slick-slide overlay-dark" style="background-image: url('/Theme/HomePage2/Slider1.jpg');">
