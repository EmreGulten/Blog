@using Blog.Web.Consts
@model List<ProductDto>


<div class="container-xxl flex-grow-1 container-p-y">
    <h4 class="fw-bold py-3 mb-4">
        <span class="text-muted fw-light">Ürün Yönetimi /</span> Ürünler
    </h4>

    <!-- Basic Bootstrap Table -->
    <div class="card">
        <div class="table-responsive text-nowrap m-5">

            @{
                @if (!User.IsInRole($"{RoleConsts.User}"))
                {
                    <a class="btn btn-success mb-3" asp-area="Admin" asp-controller="Product" asp-action="Add">
                        Ürün Ekle <i class="bx bx-plus"></i>
                    </a>
                }
            }


            <table class="table table-bordered" id="productsTable" width="100%" cellspacing="0">
                <thead>
                    <tr>
                        <th>Adı</th>
                        <th>Fiyat</th>
                        <th>Stok Miktarı</th>
                        <th>Kategori</th>
                        <th>Açıklama</th>
                        <th>Durum</th>
                        @{
                            @if (!User.IsInRole($"{RoleConsts.User}"))
                            {
                                <th>İşlemler</th>
                            }
                        }
                    </tr>
                </thead>
                <tfoot>
                    <tr>
                        <th>Adı</th>
                        <th>Fiyat</th>
                        <th>Stok Miktarı</th>
                        <th>Kategori</th>
                        <th>Açıklama</th>
                        <th>Durum</th>
                        @{
                            @if (!User.IsInRole($"{RoleConsts.User}"))
                            {
                                <th>İşlemler</th>
                            }
                        }

                    </tr>
                </tfoot>
                <tbody class="table-border-bottom-0">
                    @foreach (var product in Model)
                    {
                        <tr name="@product.Id">
                            <td>@product.Name</td>
                            <td>@product.Price</td>
                            <td>@product.StockQuantity</td>
                            <td>@product.CategoryId</td>
                            <td>@product.Description</td>
                            <td>@(product.IsDeleted ? "Aktif Değil" : "Aktif")</td>
                            @{
                                @if (!User.IsInRole($"{RoleConsts.User}"))
                                {

                                    <td>

                                        <a class="btn btn-primary btn-sm" data-id="@product.Id" asp-area="Admin" asp-controller="Product" asp-action="Update" asp-route-productId="@product.Id"><i class="bx bxs-edit"></i></a>
                                        <a class="btn btn-danger btn-sm" data-id="@product.Id" asp-area="Admin" asp-controller="Product" asp-action="Delete" asp-route-productId="@product.Id"><i class="bx bx-minus-circle"></i></a>


                                    </td>
                                }
                            }
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
    <!--/ Basic Bootstrap Table -->




</div>

@section Scripts{
    <script src="~/js/productIndex.js" type="application/ecmascript"></script>
}